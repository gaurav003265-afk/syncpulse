# SyncPulse Environment Configuration Template
# Copy to .env and adjust for local or production deployments

# Server Configuration
PORT=8000
HOST=127.0.0.1
SYNCPULSE_ENV=production

# API Endpoints
VITE_API_BASE_URL=http://localhost:8000
OFFLINE_SYNC_INTERVAL_SEC=300

# Geographic & Administrative Context
DEFAULT_VILLAGE=Ramnagar
ASHA_DISTRICT_CODE=AP-KRI
PHC_EMERGENCY_PHONE=108

# Feature Toggles
ENABLE_LOCAL_SQLITE=true
ENABLE_AMBULANCE_DISPATCH_API=false
